# ===========================================
# SOS Services - Environment Configuration
# ===========================================

# Database
POSTGRES_USER=sosservices
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=sosservices
DATABASE_URL=postgresql+asyncpg://sosservices:changeme_in_production@db:5432/sosservices

# Redis
REDIS_URL=redis://redis:6379/0

# IPMA (Portuguese weather service - no key required)
IPMA_BASE_URL=https://api.ipma.pt/open-data

# OpenWeatherMap (free tier: 1000 calls/day)
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# NASA FIRMS (free, register at https://firms.modaps.eosdis.nasa.gov/)
NASA_FIRMS_API_KEY=your_nasa_firms_key_here

# TomTom Traffic API (free tier)
TOMTOM_API_KEY=your_tomtom_key_here

# Ticketmaster Discovery API (free tier)
TICKETMASTER_API_KEY=your_ticketmaster_key_here

# football-data.org API (optional)
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# Proteção Civil (no key required - public RSS/JSON)
PROCIV_BASE_URL=https://www.prociv.pt

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# Portugal bounding box (used for filtering)
PT_LAT_MIN=36.96
PT_LAT_MAX=42.15
PT_LON_MIN=-9.50
PT_LON_MAX=-6.19
